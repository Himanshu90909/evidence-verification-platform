# --- Service ---
ML_API_KEY=change-me-generate-a-long-random-string
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Model configuration ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
# Optional cross-encoder reranker. Leave empty to use NLI-based reranking.
RERANKER_MODEL=

# --- Corpus & indexes ---
DATA_DIR=./data
CORPUS_PATH=./data/corpus/evidence_corpus.jsonl
INDEX_DIR=./data/indexes
CORPUS_MAX_DOCUMENTS=0            # 0 = full corpus
CORPUS_SEED=42

# --- Pipeline ---
TOP_K=5
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
USE_RRF=true                       # reciprocal-rank fusion vs weighted scores
TEMPERATURE=1.0                    # NLI temperature scaling from calibration
MIN_EVIDENCE_PROB=0.35             # entailment mass below this -> NEI leaning
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Behaviour ---
ALLOW_UNAUTHENTICATED=false        # true only for local tests
